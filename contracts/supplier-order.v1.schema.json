{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.f4ge.io/schemas/supplier-risk/supplier-order.v1.schema.json",
  "title": "Supplier Risk — Order (입력, 발주 시점 확정)",
  "description": "[신규 정의] F4GE 가 협력 공장에 낸 오더 1건. **발주 시점에 확정되는 값만** 담는다 — 그 뒤에 알게 되는 것(보고·검사·클레임)은 다른 계약이다. 이 계약의 모든 필드는 우리 손에 있는 사실(L0)이라 공장 협조가 필요 없다. datasets/generated/orders.jsonl 의 한 줄. 파생값(lead_slack · price_zscore · load_index)은 피처이므로 계약에 넣지 않는다 — 원값(promised_date · unit_price · 동시 오더)에서 만든다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "order_id",
    "factory_id",
    "product_code",
    "market",
    "order_quantity",
    "ordered_at",
    "promised_date"
  ],
  "properties": {
    "schema_version": {
      "const": "supplier_risk.order.v1"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "order_id": {
      "type": "string",
      "pattern": "^ord_[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "factory_id": {
      "type": "string",
      "pattern": "^fac_[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "product_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$",
      "examples": [
        "bracket",
        "shaft",
        "housing",
        "flange"
      ],
      "description": "제품군 코드. FactoryOS 규칙(part_id/product_id 금지)을 따라 id 가 아니라 code 다. 같은 제품군을 여러 공장이 만드는 것이 배분 모델의 전제다."
    },
    "market": {
      "type": "string",
      "enum": [
        "eu",
        "us_west",
        "us_east"
      ],
      "description": "납품처. **라벨 지연을 정한다** — 입고검사 결과가 미 서안 18일 · 미 동안 30일 · 유럽 60일 뒤에 온다."
    },
    "order_quantity": {
      "type": "integer",
      "minimum": 1
    },
    "ordered_at": {
      "type": "string",
      "format": "date-time",
      "description": "발주 시각. 이 오더의 모든 시간 규율(label_available_at 등)의 기준점."
    },
    "promised_date": {
      "type": "string",
      "format": "date-time",
      "description": "발주 시점에 공장이 약속한 납기. 이후 변경은 factory-report.v1 의 promised_date_reported 에 쌓인다."
    },
    "quoted_at": {
      "type": "string",
      "format": "date-time",
      "description": "견적 요청 시각."
    },
    "quote_response_h": {
      "type": "number",
      "minimum": 0,
      "description": "견적 응답까지 걸린 시간(h). 우리가 자동으로 남기는 L0′ — 조작 불가 신호."
    },
    "unit_price": {
      "type": "number",
      "minimum": 0,
      "description": "단가. 통화는 tenant 설정을 따른다."
    },
    "aql_major": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "계약 AQL(major). ISO 2859-1. 기본 0.025."
    },
    "aql_minor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "계약 AQL(minor). 기본 0.040."
    },
    "material_lot_id": {
      "type": "string",
      "pattern": "^mtl_[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "material_supplier": {
      "type": "string",
      "pattern": "^sup_[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "자재 공급사. 공장 간 불량 전파를 잡는 유일한 경로."
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "partner_confidential",
        "customer_controlled",
        "regulated_itar",
        "security_sensitive"
      ],
      "default": "internal"
    }
  }
}
